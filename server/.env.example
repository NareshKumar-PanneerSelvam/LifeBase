# App Configuration
APP_NAME="LifeBase Server"
ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="lifebase"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# Security & JWT Configuration
# Generate a secure key in production using: openssl rand -hex 32
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_SECRET_KEY="your-super-secret-admin-key-change-in-production"

# CORS Configuration
# Must be a JSON-encoded list of origins
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]'
